# Optional values for the retained Vite frontends. Copy this file to
# nichescope-phase9/.env for the launcher-selected frontend. Never put secrets
# in VITE_* variables; Vite embeds them in browser assets.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Used by retained frontend server templates. The phase9 launcher starts Vite
# instead of those Node servers.
VITE_API_BASE_URL=/api
VITE_API_MODE=api
NICHESCOPE_DB_PATH=data/scraper_analysis.db
DATABASE_PATH=data/scraper_analysis.db
NODE_ENV=development
PORT=3000
