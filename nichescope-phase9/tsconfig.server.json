{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "types": ["node"],
    "rootDir": "server",
    "outDir": "dist",
    "noEmit": false,
    "incremental": false
  },
  "include": ["server/index.ts"]
}
